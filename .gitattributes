# Normalize line endings
* text=auto eol=lf

# C/C++ sources
*.c   text diff=cpp
*.cc  text diff=cpp
*.cpp text diff=cpp
*.h   text diff=cpp
*.hpp text diff=cpp

# Bazel / Starlark
*.bzl  text
*.bazel text
MODULE.bazel text
WORKSPACE.bazel text

# Python
*.py text diff=python

# Shell
*.sh text eol=lf

# Data
*.json text
*.md text

# Never treat as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
